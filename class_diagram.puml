@startuml GYM_APP_ClassDiagram
!define ABSTRACT abstract

' Configuración visual
skinparam classBackgroundColor #F1F1F1
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam backgroundColor #FEFEFE

' ============================================
' MÓDULO: USUARIOS
' ============================================
package "Módulo Usuarios" #FFE6E6 {
    class User {
        id: Integer {id}
        nombre: String
        apellido_paterno: String
        apellido_materno: String
        telefono: String
        correo: String {unique}
        telefono_emergencia: String
        nip: String
        activo: Boolean
        membership_id: Integer {fk}
        membership_start_date: DateTime
        membership_end_date: DateTime
        created_at: DateTime
        updated_at: DateTime
        --
        + getId(): Integer
        + getNombre(): String
        + getMembership(): Membership
        + getDiasRestantes(): Integer
        + isActivo(): Boolean
        + setMembership(membership: Membership): void
        + updateMembership(membership: Membership, startDate: DateTime): void
    }

    class UserRepository {
        - database: Database
        --
        + getAll(): List<User>
        + getById(id: Integer): User
        + getByEmail(email: String): User
        + create(user: User): void
        + update(user: User): void
        + delete(id: Integer): void
        + getByMembershipStatus(status: String): List<User>
        + assignMembership(userId: Integer, membershipId: Integer, startDate: DateTime): void
    }

    class UserForm {
        - formData: Object
        - errors: List<String>
        --
        + getNombre(): String
        + getApellidos(): String
        + getTelefono(): String
        + getCorreo(): String
        + getTelefonoEmergencia(): String
        + getNip(): String
        + validate(): Boolean
        + reset(): void
    }

    class UserCard {
        - user: User
        - isDarkMode: Boolean
        --
        + render(): JSX
        + handleEdit(): void
        + handleDelete(): void
        + handleChangeStatus(): void
    }

    class UserTable {
        - users: List<User>
        - sortColumn: String
        - sortOrder: String
        --
        + render(): JSX
        + handleSort(column: String): void
        + renderRows(): JSX
        + getStatusColor(user: User): String
    }

    UserRepository --> User : maneja
    UserForm --> User : crea/edita
    UserCard --> User : muestra
    UserTable --> User : lista
}

' ============================================
' MÓDULO: MEMBRESÍAS
' ============================================
package "Módulo Membresías" #E6F3FF {
    class Membership {
        id: Integer {id}
        nombre: String
        descripcion: String
        duracion_dias: Integer
        precio: Real
        beneficios: String
        activo: Boolean
        created_at: DateTime
        updated_at: DateTime
        --
        + getId(): Integer
        + getNombre(): String
        + getDuracionDias(): Integer
        + getPrecio(): Real
        + isActivo(): Boolean
        + getDescripcion(): String
        + getBeneficios(): String
    }

    class MembershipRepository {
        - database: Database
        --
        + getAll(): List<Membership>
        + getById(id: Integer): Membership
        + getActive(): List<Membership>
        + create(membership: Membership): void
        + update(membership: Membership): void
        + delete(id: Integer): void
        + getMembershipsByUser(userId: Integer): List<Membership>
    }

    class MembershipCard {
        - membership: Membership
        - isDarkMode: Boolean
        --
        + render(): JSX
        + handleSelect(): void
        + displayPrice(): String
        + displayDays(): String
    }

    class MembershipForm {
        - formData: Object
        - isEditing: Boolean
        --
        + getNombre(): String
        + getDescripcion(): String
        + getDuracionDias(): Integer
        + getPrecio(): Real
        + getBeneficios(): String
        + validate(): Boolean
        + reset(): void
    }

    class MembershipTable {
        - memberships: List<Membership>
        --
        + render(): JSX
        + handleEdit(membership: Membership): void
        + handleDelete(id: Integer): void
        + renderRows(): JSX
    }

    MembershipRepository --> Membership : maneja
    MembershipForm --> Membership : crea/edita
    MembershipCard --> Membership : muestra
    MembershipTable --> Membership : lista
}

' ============================================
' MÓDULO: ASIGNACIÓN DE MEMBRESÍAS
' ============================================
package "Módulo Asignación Membresías" #FFE6F0 {
    class AssignMembershipModal {
        - user: User
        - currentMembership: Membership
        - isOpen: Boolean
        --
        + render(): JSX
        + handleAssign(membership: Membership): void
        + calculateEndDate(startDate: DateTime, days: Integer): DateTime
        + displayDiasRestantes(): Integer
    }

    class AddMembershipModal {
        - user: User
        - currentMembership: Membership
        - selectedMembership: Membership
        - showPaymentForm: Boolean
        --
        + render(): JSX
        + handleSelectMembership(membership: Membership): void
        + handleAddMembership(): void
        + calculateTotalDespues(): Integer
        + handlePaymentRegistration(payment: Payment): void
        + showAvailableMemberships(): List<Membership>
    }

    class RenewalMembershipModal {
        --
        + render(): JSX
    }

    AssignMembershipModal --> User : trabaja con
    AssignMembershipModal --> Membership : asigna
    AddMembershipModal --> User : trabaja con
    AddMembershipModal --> Membership : añade
    AddMembershipModal --> Payment : registra
}

