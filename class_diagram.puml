' ============================================
' MÓDULO: MÁQUINAS
' ============================================
package "Módulo Máquinas" #F0E6FF {
    class Machine {
        id: Integer {id}
        nombre: String
        categoria: String
        marca: String
        modelo: String
        numero_serie: String
        ubicacion: String
        estado: String
        fecha_compra: Date
        ultimo_mantenimiento: Date
        proximo_mantenimiento: Date
        notas: String
        activo: Boolean
        created_at: DateTime
        updated_at: DateTime
        --
        + getId(): Integer
        + getNombre(): String
        + getCategoria(): String
        + getUbicacion(): String
        + getEstado(): String
        + isActivo(): Boolean
        + needsMaintenance(): Boolean
    }

    class MachineCategory {
        id: Integer {id}
        nombre: String
        color: String
        activo: Boolean
        created_at: DateTime
        --
        + getId(): Integer
        + getNombre(): String
        + getColor(): String
    }

    class MachineLocation {
        id: Integer {id}
        nombre: String
        descripcion: String
        activo: Boolean
        created_at: DateTime
        --
        + getId(): Integer
        + getNombre(): String
        + getDescripcion(): String
    }

    class MachineRepository {
        - database: Database
        --
        + getAll(): List<Machine>
        + getById(id: Integer): Machine
        + getByCategoria(categoria: String): List<Machine>
        + getByUbicacion(ubicacion: String): List<Machine>
        + getByEstado(estado: String): List<Machine>
        + create(machine: Machine): void
        + update(machine: Machine): void
        + delete(id: Integer): void
        + getMachinesNeedingMaintenance(): List<Machine>
    }

    class MachineRepository {
        - database: Database
        --
        + getAllCategories(): List<MachineCategory>
        + createCategory(category: MachineCategory): void
        + deleteCategory(id: Integer): void
        + getAllLocations(): List<MachineLocation>
        + createLocation(location: MachineLocation): void
        + deleteLocation(id: Integer): void
    }

    MachineRepository --> Machine : maneja
    MachineRepository --> MachineCategory : maneja
    MachineRepository --> MachineLocation : maneja
    Machine --> MachineCategory : pertenece a
    Machine --> MachineLocation : ubicada en
}

