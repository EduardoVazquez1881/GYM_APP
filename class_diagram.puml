' ============================================
' MÓDULO: BASE DE DATOS
' ============================================
package "Módulo Base de Datos" #E6E6E6 {
    ABSTRACT class BaseRepository {
        # database: Database
        --
        + {abstract} getAll(): List<T>
        + {abstract} getById(id: Integer): T
        + {abstract} create(entity: T): void
        + {abstract} update(entity: T): void
        + {abstract} delete(id: Integer): void
        # executeQuery(query: String, params: Array): Array
        # executeUpdate(query: String, params: Array): Integer
    }

    class Database {
        - db: sqlite3.Database
        - isInitialized: Boolean
        --
        + initialize(): void
        + createTables(): void
        + close(): void
        + getConnection(): Connection
        + runMigrations(): void
        + getTableStatus(): Object
    }

    BaseRepository --> Database : utiliza
    UserRepository --|> BaseRepository
    MembershipRepository --|> BaseRepository
    CheckInRepository --|> BaseRepository
    PaymentRepository --|> BaseRepository
    MachineRepository --|> BaseRepository
    AdminRepository --|> BaseRepository
}

